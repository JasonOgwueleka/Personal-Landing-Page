# Template. Copy to .env and fill in the values:  cp .env.example .env
# .env is gitignored; this example file is safe to commit (no real values).
# The same three variables must also be set in Netlify:
#   Site configuration -> Environment variables

# Resend API key ("Collaboration Inquiries", sending access).
# Paste the real value into .env — Resend only shows it once.
RESEND_API_KEY=

# Recipient for enquiry form submissions.
ENQUIRY_TO=jasonogwueleka@gmail.com

# Sender address. Must be on a domain verified in Resend.
# Leave as-is until a domain is verified; Resend's test sender only
# delivers to the email address on your own Resend account.
ENQUIRY_FROM=Enquiries <onboarding@resend.dev>
